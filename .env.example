# Copy this file to .env and fill in your values.
# Get a Gemini API key from https://aistudio.google.com/app/apikey

GOOGLE_API_KEY= your gemini api key here

# Gemini models
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# RAG settings
RETRIEVER_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Evaluator -> conditional retry routing
FAITHFULNESS_THRESHOLD=0.5
MAX_RETRIEVAL_ATTEMPTS=2

# Optional: LangSmith tracing (leave LANGCHAIN_TRACING_V2=false to use local file logging instead)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-knowledge-assistant

# MCP Filesystem Server launch command (defaults use npx, requires Node.js)
MCP_FILESYSTEM_COMMAND=npx
MCP_FILESYSTEM_ARGS=-y @modelcontextprotocol/server-filesystem
